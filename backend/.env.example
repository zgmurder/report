APP_NAME=警情智能报告
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

# 示例：mysql+pymysql://user:password@127.0.0.1:3306/report?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/report?charset=utf8mb4
